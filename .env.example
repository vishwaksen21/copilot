# Backend
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/interview_copilot
REDIS_URL=redis://localhost:6379/0

# AI
