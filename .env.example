OLLAMA_BASE_URL=http://localhost:11434

# Encryption
MASTER_KEY=auto-generated-on-first-run

# Speech
WHISPER_MODEL_SIZE=base.en
SAMPLE_RATE=16000

# App
APP_ENV=development
LOG_LEVEL=INFO
